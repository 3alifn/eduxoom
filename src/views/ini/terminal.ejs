<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Terminal</title>
  <%- include("../component/metadata.html") %> 
</head>
<style>
/* Terminal styles converted to plain CSS for browser compatibility */
body{ background-color: #000; color: #c8f6b0; font-family: 'AndaleMono', monospace; }
.terminal-wrap{ padding: 1rem; max-width: 900px; margin: 1rem auto; }
.terminal .prompt{ color: #c8f6b0; font-weight: bold; text-transform: uppercase; margin-bottom: .75rem; }
.prompt-elem{ color: #c8f6b0; display:block; font-weight:700; letter-spacing: .08em; }
.prompt-elem-msg{ display:inline-block; }
.prompt-elem-msg code{ color: #c8f6b0; background: transparent; border: none; }
/* blinking cursor */
.cursor-block{ display:inline-block; vertical-align: middle; width: .6em; height: 1em; margin-left: .4em; background: #c8f6b0; animation: cursorBlink 1.25s steps(1) infinite; }
@keyframes cursorBlink{ 0%{ opacity:0 } 50%{ opacity:1 } 100%{ opacity:0 } }
.input{ position: absolute; left:-9999px; }
.output-line{ margin: .25rem 0; }
.note{ color: #9CA3AF; font-size: .9rem; }
</style>
<body onload="pageLoadingTop()">

  <div class="terminal-wrap">
    <div class="row">
      <div class="col-12">
        <div class="prompt">Enter a domain with lics key; "domain.saanviabc.com $ ABC-123-XYZ"</div>
        <div class="ini_key mb-2" style="font-weight:700;">
          <label for="ini_key" class="visually-hidden">Ini key</label>
          <input id="ini_key" autocomplete="off" autofocus type="password" placeholder="*************" name="password" value="" style="background:transparent; border: none; color: #c8f6b0;">
        </div>

        <div id="terminal" class="terminal">
          <div class="prompt-elem">
            <p class="prompt-elem-msg text-uppercase"><code class="ps-2 fs-5 fw-bold"></code><span class="cursor-block" aria-hidden="true"></span></p>
          </div>
        </div>

        <div class="note mt-3">Tip: use commands like <code>SAANVI GET ALL</code>, <code>SAANVI ADD INI domain $ LIC</code>, or <code>--help</code>.</div>
      </div>
    </div>
  </div>

<script>
(function(){
  var hiddenInput = document.createElement('input');
  hiddenInput.className = 'input';
  hiddenInput.autocomplete = 'off';
  document.body.appendChild(hiddenInput);
  hiddenInput.focus();

  var terminal = document.getElementById('terminal');
  var iniKeyInput = document.getElementById('ini_key');

  var commandHistory = [];
  var historyIndex = -1;

  function escapeHtml(s){ return String(s).replace(/[&<>"']/g, function(c){ return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#39;" }[c]; }); }

  function appendOutput(html){
    var div = document.createElement('div');
    div.className = 'output-line';
    div.innerHTML = html;
    terminal.querySelector('.prompt-elem').appendChild(div);
    // create new prompt line
    terminal.appendChild(createEmptyPrompt());
    // keep scrolled to bottom
    window.scrollTo(0, document.body.scrollHeight);
  }

  function createEmptyPrompt(){
    var p = document.createElement('p');
    p.className = 'prompt-elem-msg text-uppercase';
    p.innerHTML = '<code class="ps-2 fs-5 fw-bold"></code><span class="cursor-block" aria-hidden="true"></span>';
    var wrapper = document.createElement('div');
    wrapper.className = 'prompt-elem';
    wrapper.appendChild(p);
    return wrapper;
  }

  hiddenInput.addEventListener('input', function(e){
    var val = hiddenInput.value.toUpperCase();
    var el = terminal.querySelector('.prompt-elem-msg code');
    if(el) el.textContent = val;
  });

  hiddenInput.addEventListener('keydown', function(e){
    if(e.key === 'Enter'){
      e.preventDefault();
      var inputdata = hiddenInput.value.trim().toUpperCase();
      if(!inputdata) return;
      commandHistory.push(inputdata);
      historyIndex = commandHistory.length;
      processCommand(inputdata);
      hiddenInput.value = '';
      terminal.querySelectorAll('.prompt-elem-msg code').forEach(function(c){ c.textContent = ''; });
    } else if(e.key === 'ArrowUp'){
      if(commandHistory.length && historyIndex > 0){ historyIndex--; hiddenInput.value = commandHistory[historyIndex]; hiddenInput.dispatchEvent(new Event('input')); }
      e.preventDefault();
    } else if(e.key === 'ArrowDown'){
      if(commandHistory.length && historyIndex < commandHistory.length-1){ historyIndex++; hiddenInput.value = commandHistory[historyIndex]; hiddenInput.dispatchEvent(new Event('input')); } else { historyIndex = commandHistory.length; hiddenInput.value = ''; hiddenInput.dispatchEvent(new Event('input')); }
      e.preventDefault();
    }
  });

  document.getElementById('terminal').addEventListener('click', function(){ hiddenInput.focus(); });

  function processCommand(inputdata){
    var ini_key = iniKeyInput.value;
    var ini_cmd = inputdata.slice(0,14);

    if(inputdata === '--HELP'){
      appendOutput('<p class="fs-6 fw-semibold">$ COMMAND FOR CLEAR => CLS</p><p class="fs-6 fw-semibold">$ COMMAND FOR STATUS ALL => SAANVI GET ALL</p>');
      return;
    }

    if(inputdata === 'CLS'){
      // clear terminal
      var elem = terminal.querySelector('.prompt-elem');
      if(elem) elem.innerHTML = '<p class="prompt-elem-msg text-uppercase"><code class="ps-2 fs-5 fw-bold"></code><span class="cursor-block" aria-hidden="true"></span></p>';
      return;
    }

    if(ini_cmd === 'SAANVI GET ALL'){
      ini_get_def(ini_key, null); return;
    }
    if(ini_cmd === 'SAANVI GET ACT'){
      ini_get_def(ini_key, 1); return;
    }
    if(ini_cmd === 'SAANVI GET DEA'){
      ini_get_def(ini_key, 0); return;
    }
    if(ini_cmd === 'SAANVI ADD INI'){
      var parts = inputdata.split('SAANVI ADD INI ');
      if(parts[1]){
        var arr = parts[1].split('$');
        var domain = (arr[0] || '').toLowerCase().trim();
        var lics = (arr[1] || '').trim();
        ini_add_def(ini_key, domain, lics); return;
      }
    }
    if(ini_cmd === 'SAANVI REN INI'){
      var domain = inputdata.split('SAANVI REN INI ')[1]; ini_ren_def(ini_key, (domain||'').toLowerCase()); return;
    }
    if(ini_cmd === 'SAANVI DEA INI'){
      var domain = inputdata.split('SAANVI DEA INI ')[1]; ini_dea_def(ini_key, (domain||'').toLowerCase()); return;
    }
    if(ini_cmd === 'SAANVI REM INI'){
      var domain = inputdata.split('SAANVI REM INI ')[1]; ini_rem_def(ini_key, (domain||'').toLowerCase()); return;
    }

    appendOutput('<p class="fs-6 fw-semibold">$ Ops! unaccepted command! for help => --help</p>');
  }

  function ini_get_def(ini_key, status){
    fetch('/ini/terminal/get', {
      method: 'POST',
      headers: { 'Content-Type':'application/json' },
      body: JSON.stringify({ ini_key: ini_key, status: status })
    }).then(r=>r.json()).then(function(res){
      if(res && res.html === true){ appendOutput(res.htmldata); }
      else{ appendOutput('<p class="fs-6 fw-semibold">$ '+ escapeHtml(res.msg || 'No response') +'</p>'); }
    }).catch(function(){ appendOutput('<p class="fs-6 fw-semibold">$ Network or server error.</p>'); });
  }

  function ini_add_def(ini_key, domain, lics){
    fetch('/ini/terminal/push', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify({ ini_key: ini_key, domain: domain, lics: lics }) })
    .then(r=>r.json()).then(function(res){ appendOutput('<p class="fs-6 fw-semibold">$ '+ escapeHtml(res.msg || 'Done') +'</p>'); }).catch(()=>{ appendOutput('<p class="fs-6 fw-semibold">$ Network or server error.</p>'); });
  }

  function ini_dea_def(ini_key, domain){
    fetch('/ini/terminal/dea', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify({ ini_key: ini_key, domain: domain }) })
    .then(r=>r.json()).then(function(res){ appendOutput('<p class="fs-6 fw-semibold">$ '+ escapeHtml(res.msg || 'Done') +'</p>'); }).catch(()=>{ appendOutput('<p class="fs-6 fw-semibold">$ Network or server error.</p>'); });
  }

  function ini_rem_def(ini_key, domain){
    fetch('/ini/terminal/rm', { method: 'POST', headers: { 'Content-Type':'application/json' }, body: JSON.stringify({ ini_key: ini_key, domain: domain }) })
    .then(r=>r.json()).then(function(res){ appendOutput('<p class="fs-6 fw-semibold">$ '+ escapeHtml(res.msg || 'Done') +'</p>'); }).catch(()=>{ appendOutput('<p class="fs-6 fw-semibold">$ Network or server error.</p>'); });
  }

})();
</script>

</body>
</html>
