
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forget Password</title>
    <%- include("../component/metadata.html") %> 
  <style>
    /* Global Styles */
body {
    margin: 0;
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background: #f4f4f4;
}


.user-img {
    display: block;
    margin: 0 auto 1rem;
}

h1 {
    text-align: center;
    color: #333;
}

p {
    text-align: center;
    color: #666;
}

label {
    display: block;
    margin-bottom: 0.5rem;
    color: #333;
    font-weight: bold;
}

.input-group {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
}

.input-group-text {
    background: #eee;
    border: none;
    border-radius: 5px 0 0 5px;
}

.form-control, .form-self {
    flex: 1;
    padding: 0.5rem;
    border: 1px solid #ddd;
    border-radius: 0 5px 5px 0;
}

.btn-primary-submit {
    background: #007bff;
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 5px;
    cursor: pointer;
    width: 100%;
}

.btn-primary-submit:hover {
    background: #0056b3;
}

.btn-primary-submit:disabled {
    background: #6c757d;
    cursor: not-allowed;
}

.specialC {
    color: #007bff;
}

.specialC:hover {
    text-decoration: underline;
}

.role-selection-group {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    border: 3px solid #ddd;
    border-radius: 5px;
    padding: 0.5rem;
}

.role-selection-group .form-check {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0.5rem;
}

.form-check-input {
    margin-right: 0.5rem;
}

.password-strength {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: bold;
}

.strength-weak {
    color: #dc3545;
}

.strength-medium {
    color: #ffc107;
}

.strength-strong {
    color: #28a745;
}

.error-message {
    color: #dc3545;
    font-size: 0.875rem;
    margin-top: 0.25rem;
}

/* Responsive Styles */
@media (max-width: 768px) {
    .col-lg-3, .col-md-2, .col-sm-1 {
        display: none;
    }

    .col-lg-5, .col-md-8, .col-sm-10 {
        width: 100%;
    }

    .role-selection-group {
        flex-direction: column;
    }

    .role-selection-group .form-check {
        width: 100%;
    }
}

  </style>
</head>

<body onload="pageLoadingTop()">
    <% if(typeof msg !== typeof alifn && msg.length > 0) { %>
        <%- include("../component/toast-ejs") %>
    <% } else { %>
        <%= null %>
    <% } %>

    <% if(step === "step1") { %>
    <!-- section 1 -->
    <div id="section1" class="section-container">
        <div class="row mt-5 mbx p-2 shadowx">
            <div class="col-lg-3 col-md-2 col-sm-1"></div>
            <div class="col-lg-5 col-md-8 col-sm-10">
                <form action="/au/forgot/password" method="post" class="form container">
                    <img src="/images/default/user.png" height="70px" alt="User Image" class="user-img">
                    <h1>Forgot Password</h1>
                    <p>Fill the form to reset your password.</p><br><br>
     
                    <fieldset>
                        <legend class="sr-only">Select your role</legend>
                        <div class="role-selection-group" role="group" aria-labelledby="roleGroupLabel">
                            <span class="input-group-text"><img width="30px" src="/icons/icons8-test-account-48.png" alt="role selection icon"></span>
                            
                            <div class="form-check">
                              <input class="form-check-input" type="radio" name="userRole" id="roleTeacher" value="teachers" checked aria-label="Sign in as Teacher">
                              <label class="form-check-label" for="roleTeacher">Teacher</label>
                            </div>
              
                            <div class="form-check">
                              <input class="form-check-input" type="radio" name="userRole" id="roleStudent" value="students" aria-label="Sign in as Student">
                              <label class="form-check-label" for="roleStudent">Student</label>
                            </div>
                  
                            <div class="form-check">
                              <input class="form-check-input" type="radio" name="userRole" id="roleParent" value="parents" aria-label="Sign in as Parent">
                              <label class="form-check-label" for="roleParent">Parent</label>
                            </div>
                          </div>
                    </fieldset>
                      
                    <p></p>
                    <div class="input-group">
                        <span class="input-group-text"><img width="30px" src="/icons/user/icons8-mail-48.png" alt=""></span>
                        <input type="text" placeholder="Enter Username" name="username" class="form-self form-control" aria-label="Username or email address" required>
                    </div>
                    <p></p>
                    <center>
                        <input type="submit" value="Continue" class="btn-primary-submit w-50">
                    </center>
                    <p></p>
                    <p>Return to <a href="/au/signin/page" id="signIn_link" class="specialC">Sign in <img width="20px" src="/icons/user/icons8-back-48.png" alt=""></a></p>
                </form>
            </div>
            <div class="col-lg-3 col-md-2 col-sm-1"></div>
        </div>
    </div>
    <% }  else if(step === "step2") { %>
    <!-- section 2 -->
    <div id="section2" class="section-container">
        <div class="row">
            <div class="col-lg-3 col-md-2 col-sm-1"></div>
            <div class="col-lg-5 col-md-8 col-sm-10">
                <form action="/au/forgot/password/verify" method="post" class="form container">
                    <img src="/images/default/user.png" height="70px" alt="User Image" class="user-img">
                    <h1>Email Sent!</h1>
                    <p>Fill the form to email verification code.</p><br><br>
                    <label for="verifyCode">Verification Code</label><br>
                    <input type="number" placeholder="Enter Code" name="verifyCode" id="verifyCode" class="form-self" aria-label="Verification code sent to your email" required>
                    <p></p>
                    <center>
                        <input type="submit" value="Verify" class="btn-primary-submit w-50">
                    </center>
                    <p></p>
                    <p>Return to <a href="/au/signin/page" id="signIn_link" class="specialC">Sign in</a></p>
                </form>
            </div>
            <div class="col-lg-3 col-md-2 col-sm-1"></div>
        </div>
    </div>
    <% }  else if(step === "step3") { %>
    <!-- section 3 -->
    <div id="section3" class="section-container">
        <div class="row">
            <div class="col-lg-3 col-md-2 col-sm-1"></div>
            <div class="col-lg-5 col-md-8 col-sm-10">
                <form id="passwordResetForm" action="/au/forgot/password/reset" method="post" class="form container">
                    <img src="/images/default/user.png" height="70px" alt="User Image" class="user-img">
                    <h1>Setup New Password</h1>
                    <p>Set up a new password and continue.</p><br><br>
                    
                    <label for="password">New Password <span aria-label="required">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><img width="30px" src="/icons/icons8-sign-in-form-password-48.png" alt=""></span>
                        <input id="password" type="password" placeholder="Minimum 8 characters" name="password" class="form-control" minlength="8" aria-label="New password, minimum 8 characters" aria-describedby="passwordHelp" required>
                        <span id="eye-hide" class="btn input-group-text" role="button" tabindex="0" aria-label="Show password"><i class="fa-sharp fa-solid fa-eye-slash"></i></span>
                        <span style="display: none;" id="eye-show" class="btn input-group-text" role="button" tabindex="0" aria-label="Hide password"><i class="fa-sharp fa-solid fa-eye"></i></span>
                    </div>
                    <div id="passwordHelp" class="password-strength">
                        <span id="strengthIndicator"></span>
                    </div>
                    <p id="passwordError" class="error-message" style="display: none;"></p>
                    
                    <label for="passwordConfirm">Confirm Password <span aria-label="required">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text"><img width="30px" src="/icons/icons8-sign-in-form-password-48.png" alt=""></span>
                        <input id="passwordConfirm" type="password" placeholder="Confirm password" name="passwordConfirm" class="form-control" minlength="8" aria-label="Confirm password" aria-describedby="confirmError" required>
                        <span id="eye-hide-confirm" class="btn input-group-text" role="button" tabindex="0" aria-label="Show confirm password"><i class="fa-sharp fa-solid fa-eye-slash"></i></span>
                        <span style="display: none;" id="eye-show-confirm" class="btn input-group-text" role="button" tabindex="0" aria-label="Hide confirm password"><i class="fa-sharp fa-solid fa-eye"></i></span>
                    </div>
                    <p id="confirmError" class="error-message" style="display: none;">Passwords do not match</p>
                    
                    <p></p>
                    <center>
                        <input type="submit" value="Reset" class="btn-primary-submit w-50" id="submitBtn">
                    </center>
                    <p></p>
                    <p>Return to <a href="/au/signin/page" id="signIn_link" class="specialC">Sign in</a></p>
                </form>
            </div>
            <div class="col-lg-3 col-md-2 col-sm-1"></div>
        </div>
    </div>
    <% } else { %>
    <%= null %>
    <% } %>

    <script>
        // Password strength checker
        function checkPasswordStrength(password) {
            let strength = 0;
            const strengthIndicator = $('#strengthIndicator');

            if (password.length >= 8) strength++;
            if (password.length >= 12) strength++;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[^a-zA-Z0-9]/.test(password)) strength++;

            if (strength === 0) {
                strengthIndicator.text('');
            } else if (strength <= 2) {
                strengthIndicator.text('Weak password').removeClass('strength-medium strength-strong').addClass('strength-weak');
            } else if (strength <= 3) {
                strengthIndicator.text('Medium password strength').removeClass('strength-weak strength-strong').addClass('strength-medium');
            } else {
                strengthIndicator.text('Strong password').removeClass('strength-weak strength-medium').addClass('strength-strong');
            }
        }

        // Eye toggle for password field
        $('#eye-hide').click(function() {
            $('#password').attr('type', 'text');
            $('#eye-hide').css({ 'display': 'none' });
            $('#eye-show').css({ 'display': 'block' });
        });

        $('#eye-show').click(function() {
            $('#password').attr('type', 'password');
            $('#eye-hide').css({ 'display': 'block' });
            $('#eye-show').css({ 'display': 'none' });
        });

        // Eye toggle for confirm password field
        $('#eye-hide-confirm').click(function() {
            $('#passwordConfirm').attr('type', 'text');
            $('#eye-hide-confirm').css({ 'display': 'none' });
            $('#eye-show-confirm').css({ 'display': 'block' });
        });

        $('#eye-show-confirm').click(function() {
            $('#passwordConfirm').attr('type', 'password');
            $('#eye-hide-confirm').css({ 'display': 'block' });
            $('#eye-show-confirm').css({ 'display': 'none' });
        });

        // Real-time password strength check
        $('#password').on('keyup', function() {
            checkPasswordStrength($(this).val());
        });

        // Form validation on submit
        $('#passwordResetForm').on('submit', function(e) {
            const password = $('#password').val();
            const confirmPassword = $('#passwordConfirm').val();
            const confirmError = $('#confirmError');

            if (password !== confirmPassword) {
                e.preventDefault();
                confirmError.show();
                $('#passwordConfirm').focus();
                return false;
            } else {
                confirmError.hide();
            }
        });

        // Keyboard support for eye toggle buttons
        $('#eye-hide, #eye-show, #eye-hide-confirm, #eye-show-confirm').on('keypress', function(e) {
            if (e.which === 13 || e.which === 32) { // Enter or Space
                e.preventDefault();
                $(this).click();
            }
        });
    </script>

    <%- include("../component/___node.html") %>
</body>
</html>
